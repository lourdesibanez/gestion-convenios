# URL de la API Laravel. En el celular no funciona "localhost":
# usá la IP de tu PC en la red local (ipconfig → Dirección IPv4)
# y levantá Laravel con: php artisan serve --host=0.0.0.0 --port=8000
#EXPO_PUBLIC_API_URL=http://10.10.9.191:8000/api #Mariano
EXPO_PUBLIC_API_URL=http://192.168.1.XX:8000/api

